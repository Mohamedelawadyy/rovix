# Copy to .env.local and adjust. Never commit real .env files.

# Application name shown in the browser tab.
VITE_APP_NAME="ABO ALI"

# API base URL used by the browser.
# Development: keep the relative path so requests go through the Vite proxy (no CORS needed).
# Production: an absolute URL, e.g. https://api.example.com/api/v1 (its origin must be in the
# backend CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=/api/v1

# Dev-server only (not exposed to the browser): Laravel backend that /api and /storage proxy to.
BACKEND_PROXY_TARGET=http://localhost:8000
